{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Antigravity Studio",
  "version": "5.0.3",
  "identifier": "com.qts.antigravity-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Antigravity Tools",
        "width": 1024,
        "height": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "visible": false
      },
      {
        "label": "mini",
        "title": "Antigravity Mini",
        "url": "index.html?mini=1",
        "width": 360,
        "height": 360,
        "decorations": false,
        "resizable": false,
        "shadow": true,
        "transparent": true,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "pet",
        "title": "Antigravity 独立桌面桌宠",
        "url": "index.html?pet=1",
        "width": 360,
        "height": 440,
        "decorations": false,
        "resizable": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; media-src 'self' asset: data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/WebView2Loader.dll": "WebView2Loader.dll",
      "../resources/antigravity-zh-CN.json": "agzh-resources/antigravity-zh-CN.json",
      "../resources/antigravity-zh-HK.json": "agzh-resources/antigravity-zh-HK.json",
      "../resources/antigravity-zh-TW.json": "agzh-resources/antigravity-zh-TW.json",
      "../resources/rules-zh-CN.json": "agzh-resources/rules-zh-CN.json",
      "../resources/desktop-zh-CN.json": "agzh-resources/desktop-zh-CN.json",
      "../resources/runtime-zh.js": "agzh-resources/runtime-zh.js",
      "../resources/skin-runtime.js": "agzh-resources/skin-runtime.js",
      "../resources/nezuko-pet.js": "agzh-resources/nezuko-pet.js",
      "../resources/loadingOverlay-zh.js": "agzh-resources/loadingOverlay-zh.js",
      "../resources/media/*": "agzh-resources/media/",
      "../resources/skins/midnight-dark/*": "agzh-resources/skins/midnight-dark/",
      "../resources/skins/nezuko-bamboo/*": "agzh-resources/skins/nezuko-bamboo/",
      "../resources/skins/nordic-aurora/*": "agzh-resources/skins/nordic-aurora/",
      "../resources/skins/obsidian-glass/*": "agzh-resources/skins/obsidian-glass/",
      "../resources/skins/sakura-light/preview.png": "agzh-resources/skins/sakura-light/preview.png",
      "../resources/skins/sakura-light/sakura.webp": "agzh-resources/skins/sakura-light/sakura.webp",
      "../resources/skins/sakura-light/skin.json": "agzh-resources/skins/sakura-light/skin.json",
      "../resources/skins/sakura-light/icons/*": "agzh-resources/skins/sakura-light/icons/",
      "../resources/skins/vermilion-lacquer/*": "agzh-resources/skins/vermilion-lacquer/"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "template": "installer.nsi"
      }
    },
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/qts2218346424-cyber/antigravity-zh-cn/releases/latest/download/updater.json",
        "https://github.com/qts2218346424-cyber/antigravity-zh-cn/releases/download/preview/updater.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0MEEzMkMwRjVEMjI4MUQKUldRZEtOTDF3RElLNURDK0tsZE1GckNUaXVmR1lJSTVGL3kvZDlpY0hkVDhzdVU1MTg0TTZuM2EK"
    },
    "process": null,
    "fs": null,
    "dialog": null,
    "opener": null,
    "single-instance": null
  }
}
