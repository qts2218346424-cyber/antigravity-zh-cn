{
  "schema": 1,
  "id": "midnight-dark",
  "name": "午夜深空 · 星海",
  "author": "Antigravity Studio",
  "version": "2.2.0",
  "description": "午夜星海低饱和深蓝夜色主题，点缀星尘夜光小团子与心愿光玉信物，适合深夜沉浸式长文阅读与编码。",
  "base": "dark",
  "preview": "preview.png",
  "colors": {
    "background": "#0d1220",
    "foreground": "#d5dcef",
    "accent": "#5cc8ff",
    "accentForeground": "#06121f",
    "sidebar": "#0a0f1b",
    "titleBar": "#080c16",
    "panel": "#0b1020",
    "border": "#1b2540",
    "selection": "#22406688",
    "input": "#121a2e",
    "muted": "#7f8bab"
  },
  "surfaces": {
    "radius": "14px",
    "glass_blur": 16,
    "card_opacity": 0.8,
    "border_glow": "rgba(92, 200, 255, 0.18)",
    "noise_grain": 0.02,
    "shadow_elevation": "0 18px 44px -12px rgba(5, 8, 18, 0.8)"
  },
  "background": {
    "image": "starfield.webp",
    "target": "conversation",
    "opacity": 0.12,
    "blur": 0,
    "position": "center",
    "size": "cover"
  },
  "font": {
    "monoFamily": "'Cascadia Code', 'JetBrains Mono', Consolas, monospace",
    "ligatures": true
  },
  "icons": {
    "semantic": {
      "app_logo": "icons/app-logo.svg",
      "new_chat": "icons/new-chat.svg",
      "automations": "icons/automations.svg",
      "customizations": "icons/customizations.svg",
      "add_project": "icons/add-project.svg",
      "search": "icons/search.svg",
      "settings": "icons/settings.svg",
      "pinned": "icons/pinned.svg",
      "thinking": "icons/thinking.svg"
    },
    "composer_charm": "icons/charm.svg"
  },
  "css": "aside, [data-sidebar='sidebar'] { border-right: 1px solid rgba(92, 200, 255, 0.14) !important; }",
  "pet": {
    "character": "prince",
    "accent": "#5cc8ff"
  },
  "cssFile": "theme.css"
}
