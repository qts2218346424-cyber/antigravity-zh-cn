{
  "schema": 1,
  "id": "midnight-dark",
  "name": "午夜深空 · 星海",
  "author": "Antigravity Studio",
  "version": "2.3.0",
  "description": "午夜星海低饱和深蓝夜色主题，底层铺设星云微光并点缀星尘夜光小团子与心愿光玉信物，适合深夜沉浸式阅读与编码。",
  "base": "dark",
  "preview": "preview.svg",
  "colors": {
    "background": "#0d1426",
    "foreground": "#e7eefc",
    "accent": "#5cc8ff",
    "accentForeground": "#051322",
    "sidebar": "#080d1a",
    "titleBar": "#060a14",
    "panel": "#16223d",
    "border": "#263961",
    "selection": "#5cc8ff2c",
    "input": "#1a2847",
    "muted": "#8b9cc2"
  },
  "surfaces": {
    "radius": "14px",
    "glass_blur": 18,
    "card_opacity": 0.84,
    "border_glow": "rgba(125, 211, 252, 0.18)",
    "noise_grain": 0.012,
    "shadow_elevation": "0 20px 46px -12px rgba(4, 8, 20, 0.70), 0 3px 10px -2px rgba(4, 8, 20, 0.42)"
  },
  "background": {
    "image": "starfield.svg",
    "target": "conversation",
    "opacity": 0.22,
    "blur": 0,
    "position": "center center",
    "size": "cover"
  },
  "font": {
    "monoFamily": "'Cascadia Code', 'JetBrains Mono', Consolas, monospace",
    "ligatures": true
  },
  "icons": {
    "filter": "saturate(1.12)",
    "semantic": {
      "app_logo": "icons/app-logo.svg",
      "new_chat": "icons/new-chat.svg",
      "automations": "icons/automations.svg",
      "customizations": "icons/customizations.svg",
      "add_project": "icons/add-project.svg",
      "search": "icons/search.svg",
      "settings": "icons/settings.svg",
      "pinned": "icons/pinned.svg",
      "thinking": "icons/thinking.svg"
    },
    "composer_charm": "icons/charm.svg"
  },
  "css": "aside, [data-sidebar='sidebar'] { border-right: 1px solid rgba(92, 200, 255, 0.16) !important; }\n.surface-composer > .surface-composer-card, form:has(textarea) { border: 1px solid rgba(92, 200, 255, 0.24) !important; }",
  "pet": {
    "character": "prince",
    "accent": "#5cc8ff"
  },
  "cssFile": "theme.css"
}
