{
  "schema": 1,
  "id": "obsidian-glass",
  "name": "黑曜石 · 液态光学",
  "author": "Antigravity Studio",
  "version": "2.2.0",
  "description": "深邃黑曜石液态亚克力光学主题，融入半透冰川琉璃小团子与微距星芒光玉信物，冷冽克制、夜间久看不疲。",
  "base": "dark",
  "colors": {
    "background": "#080a0f",
    "foreground": "#e6edf7",
    "accent": "#38bdf8",
    "accentForeground": "#04131e",
    "sidebar": "#0c1018",
    "titleBar": "#07090e",
    "panel": "#0f141f",
    "border": "#1f293b",
    "selection": "#38bdf833",
    "input": "#131a27",
    "muted": "#7e8ca6"
  },
  "surfaces": {
    "radius": "14px",
    "glass_blur": 20,
    "card_opacity": 0.72,
    "border_glow": "rgba(186, 230, 253, 0.16)",
    "noise_grain": 0.035,
    "shadow_elevation": "0 20px 50px -12px rgba(0, 0, 0, 0.75)"
  },
  "font": {
    "family": "Inter, 'SF Pro Text', 'PingFang SC', 'Microsoft YaHei UI', sans-serif",
    "monoFamily": "'JetBrains Mono', 'Cascadia Code', Consolas, monospace",
    "size": 13,
    "ligatures": true
  },
  "css": "aside, [data-sidebar='sidebar'] { backdrop-filter: blur(var(--agzh-glass-blur, 20px)); -webkit-backdrop-filter: blur(var(--agzh-glass-blur, 20px)); }\nform:has(textarea) { border: 1px solid rgba(56, 189, 248, 0.22) !important; }",
  "pet": {
    "character": "prince",
    "accent": "#38bdf8",
    "scale": 1
  },
  "icons": {
    "semantic": {
      "app_logo": "icons/app-logo.svg",
      "new_chat": "icons/new-chat.svg",
      "automations": "icons/automations.svg",
      "customizations": "icons/customizations.svg",
      "add_project": "icons/add-project.svg",
      "search": "icons/search.svg",
      "settings": "icons/settings.svg",
      "pinned": "icons/pinned.svg",
      "thinking": "icons/thinking.svg"
    },
    "composer_charm": "icons/charm.svg"
  },
  "cssFile": "theme.css"
}
