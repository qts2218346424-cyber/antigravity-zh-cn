{
  "schema": 1,
  "id": "clannad-starfish-library",
  "name": "CLANNAD · 图书室海星与提琴",
  "author": "Antigravity Studio",
  "version": "2.3.0",
  "description": "灵感源自一之濑琴美黄昏图书室与伊吹风子木雕海星：内置微笑木雕海星与琴美薰衣草垂耳缎带图标组、古籍共读摆件，暮色紫檀低眩光深邃护眼。",
  "base": "dark",
  "preview": "preview.svg",
  "colors": {
    "background": "#141022",
    "foreground": "#f2eefb",
    "accent": "#c084fc",
    "accentForeground": "#1a1026",
    "sidebar": "#0e0b18",
    "titleBar": "#0b0813",
    "panel": "#201936",
    "border": "#3b2e5e",
    "selection": "#c084fc2c",
    "input": "#261e40",
    "muted": "#a395c4"
  },
  "surfaces": {
    "radius": "14px",
    "glass_blur": 18,
    "card_opacity": 0.84,
    "border_glow": "rgba(192, 132, 252, 0.22)",
    "noise_grain": 0.014,
    "shadow_elevation": "0 20px 48px -12px rgba(10, 6, 20, 0.74), 0 3px 10px -2px rgba(10, 6, 20, 0.44)"
  },
  "variables": {
    "--agzh-kotomi-violet": "#c084fc",
    "--agzh-fuko-starfish": "#fb923c"
  },
  "background": [
    {
      "image": "starfish-twilight.svg",
      "target": "conversation",
      "opacity": 0.2,
      "blur": 0,
      "position": "right bottom",
      "size": "380px",
      "repeat": "no-repeat"
    }
  ],
  "font": {
    "family": "Inter, 'HarmonyOS Sans SC', 'PingFang SC', 'Microsoft YaHei UI', sans-serif",
    "monoFamily": "'JetBrains Mono', 'Cascadia Code', Consolas, monospace",
    "size": 13,
    "ligatures": true
  },
  "icons": {
    "color": "#c084fc",
    "semantic": {
      "app_logo": "icons/app-logo.svg",
      "new_chat": "icons/new-chat.svg",
      "automations": "icons/automations.svg",
      "customizations": "icons/customizations.svg",
      "add_project": "icons/add-project.svg",
      "search": "icons/search.svg",
      "settings": "icons/settings.svg",
      "pinned": "icons/pinned.svg",
      "thinking": "icons/thinking.svg"
    },
    "composer_charm": "icons/charm.svg"
  },
  "css": "aside, [data-sidebar='sidebar'] { border-right: 1px solid rgba(192, 132, 252, 0.18) !important; }\n.surface-composer > .surface-composer-card, form:has(textarea) { border: 1px solid rgba(192, 132, 252, 0.28) !important; }",
  "pet": {
    "character": "ushio",
    "accent": "#c084fc",
    "scale": 1
  },
  "cssFile": "theme.css"
}
