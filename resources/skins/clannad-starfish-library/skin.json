{
  "schema": 1,
  "id": "clannad-starfish-library",
  "name": "CLANNAD · 图书室海星与提琴",
  "author": "Antigravity Studio",
  "version": "2.2.0",
  "description": "灵感源自一之濑琴美黄昏图书室与伊吹风子木雕海星：内置微笑木雕海星与琴美薰衣草垂耳缎带图标组、古籍共读摆件，暮色紫檀低眩光深邃护眼。",
  "base": "dark",
  "preview": "preview.svg",
  "colors": {
    "background": "#120f1c",
    "foreground": "#efeaf8",
    "accent": "#c084fc",
    "accentForeground": "#1a1026",
    "sidebar": "#181326",
    "titleBar": "#100d19",
    "panel": "#161122",
    "border": "#2f2447",
    "selection": "#c084fc29",
    "input": "#1e1730",
    "muted": "#9b8cb8"
  },
  "surfaces": {
    "radius": "14px",
    "glass_blur": 18,
    "card_opacity": 0.78,
    "border_glow": "rgba(192, 132, 252, 0.22)",
    "noise_grain": 0.028,
    "shadow_elevation": "0 20px 48px -12px rgba(10, 6, 20, 0.80)"
  },
  "variables": {
    "--agzh-kotomi-violet": "#c084fc",
    "--agzh-fuko-starfish": "#fb923c"
  },
  "background": [
    {
      "image": "starfish-twilight.svg",
      "target": "conversation",
      "opacity": 0.18,
      "blur": 0,
      "position": "right bottom",
      "size": "360px",
      "repeat": "no-repeat"
    }
  ],
  "font": {
    "family": "Inter, 'HarmonyOS Sans SC', 'PingFang SC', 'Microsoft YaHei UI', sans-serif",
    "monoFamily": "'JetBrains Mono', 'Cascadia Code', Consolas, monospace",
    "size": 13,
    "ligatures": true
  },
  "icons": {
    "color": "#c084fc",
    "semantic": {
      "app_logo": "icons/app-logo.svg",
      "new_chat": "icons/new-chat.svg",
      "automations": "icons/automations.svg",
      "customizations": "icons/customizations.svg",
      "add_project": "icons/add-project.svg",
      "search": "icons/search.svg",
      "settings": "icons/settings.svg",
      "pinned": "icons/pinned.svg",
      "thinking": "icons/thinking.svg"
    },
    "composer_charm": "icons/charm.svg"
  },
  "css": "aside, [data-sidebar='sidebar'] { border-right: 1px solid rgba(192, 132, 252, 0.18) !important; }\nform:has(textarea) { border: 1px solid rgba(192, 132, 252, 0.28) !important; box-shadow: 0 14px 34px -10px rgba(10, 6, 20, 0.75), inset 0 1px 0 rgba(192, 132, 252, 0.18); }",
  "pet": {
    "character": "ushio",
    "accent": "#c084fc",
    "scale": 1
  },
  "cssFile": "theme.css"
}
