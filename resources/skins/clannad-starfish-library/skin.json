{
  "schema": 1,
  "id": "clannad-starfish-library",
  "name": "CLANNAD · 图书室海星与提琴",
  "author": "Antigravity Studio",
  "version": "2.0.0",
  "description": "灵感源自一之濑琴美静谧的黄昏图书室与伊吹风子承载祝福的木雕海星：暮色紫檀深空底色、薰衣草提琴弦光与斜阳暖橙窗影。",
  "base": "dark",
  "preview": "preview.svg",
  "colors": {
    "background": "#120f1c",
    "foreground": "#efeaf8",
    "accent": "#c084fc",
    "accentForeground": "#1a1026",
    "sidebar": "#181326",
    "activityBar": "#0e0b16",
    "titleBar": "#100d19",
    "statusBar": "#3b235a",
    "panel": "#161122",
    "border": "#2f2447",
    "selection": "#c084fc30",
    "input": "#1e1730",
    "muted": "#9b8cb8"
  },
  "surfaces": {
    "radius": "14px",
    "glass_blur": 18,
    "card_opacity": 0.78,
    "border_glow": "rgba(192, 132, 252, 0.22)",
    "noise_grain": 0.028,
    "shadow_elevation": "0 20px 48px -12px rgba(10, 6, 20, 0.80)"
  },
  "variables": {
    "--agzh-kotomi-violet": "#c084fc",
    "--agzh-fuko-starfish": "#fb923c"
  },
  "background": [
    {
      "image": "starfish-twilight.svg",
      "target": "editor",
      "opacity": 0.18,
      "blur": 0,
      "position": "right bottom",
      "size": "360px",
      "repeat": "no-repeat"
    }
  ],
  "font": {
    "family": "Inter, 'HarmonyOS Sans SC', 'PingFang SC', 'Microsoft YaHei UI', sans-serif",
    "monoFamily": "'JetBrains Mono', 'Cascadia Code', Consolas, monospace",
    "size": 13,
    "ligatures": true
  },
  "icons": {
    "color": "#c084fc",
    "codicons": {
      "star-full": "icons/starfish.svg",
      "music": "icons/starfish.svg"
    }
  },
  "css": ".monaco-workbench .part.statusbar { background-image: linear-gradient(90deg, #3b235a 0%, #581c87 65%, #7e22ce 100%) !important; }\n.monaco-workbench .monaco-list-row.selected { box-shadow: inset 2px 0 0 #c084fc; }",
  "pet": {
    "character": "ushio",
    "accent": "#c084fc",
    "scale": 1.0
  }
}
