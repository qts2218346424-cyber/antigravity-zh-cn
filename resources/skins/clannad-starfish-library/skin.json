{
  "schema": 1,
  "id": "clannad-starfish-library",
  "name": "CLANNAD · 图书室海星与提琴",
  "author": "Antigravity Studio",
  "version": "2.1.0",
  "description": "灵感源自一之濑琴美静谧的黄昏图书室与伊吹风子承载祝福的木雕海星：暮色紫檀深空对话画布、薰衣草提琴弦光思考卡片与斜阳暖橙窗影。",
  "base": "dark",
  "preview": "preview.svg",
  "colors": {
    "background": "#120f1c",
    "foreground": "#efeaf8",
    "accent": "#c084fc",
    "accentForeground": "#1a1026",
    "sidebar": "#181326",
    "titleBar": "#100d19",
    "panel": "#161122",
    "border": "#2f2447",
    "selection": "#c084fc30",
    "input": "#1e1730",
    "muted": "#9b8cb8"
  },
  "surfaces": {
    "radius": "14px",
    "glass_blur": 18,
    "card_opacity": 0.78,
    "border_glow": "rgba(192, 132, 252, 0.22)",
    "noise_grain": 0.028,
    "shadow_elevation": "0 20px 48px -12px rgba(10, 6, 20, 0.80)"
  },
  "variables": {
    "--agzh-kotomi-violet": "#c084fc",
    "--agzh-fuko-starfish": "#fb923c"
  },
  "background": [
    {
      "image": "starfish-twilight.svg",
      "target": "conversation",
      "opacity": 0.18,
      "blur": 0,
      "position": "right bottom",
      "size": "360px",
      "repeat": "no-repeat"
    }
  ],
  "font": {
    "family": "Inter, 'HarmonyOS Sans SC', 'PingFang SC', 'Microsoft YaHei UI', sans-serif",
    "monoFamily": "'JetBrains Mono', 'Cascadia Code', Consolas, monospace",
    "size": 13,
    "ligatures": true
  },
  "icons": {
    "color": "#c084fc"
  },
  "css": "aside, [data-sidebar='sidebar'] { border-right: 1px solid rgba(192, 132, 252, 0.18) !important; }\nform:has(textarea) { border: 1px solid rgba(192, 132, 252, 0.28) !important; box-shadow: 0 14px 34px -10px rgba(10, 6, 20, 0.75), inset 0 1px 0 rgba(192, 132, 252, 0.18); }",
  "pet": {
    "character": "ushio",
    "accent": "#c084fc",
    "scale": 1.0
  }
}
