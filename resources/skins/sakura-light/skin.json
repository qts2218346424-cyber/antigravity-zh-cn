{
  "schema": 1,
  "id": "sakura-light",
  "name": "樱雪晴空 · 浅色",
  "author": "Antigravity Studio",
  "version": "2.1.0",
  "description": "柔和清透的日间樱粉浅色主题，智能体对话画布飘落半透明樱瓣纹理，搭配温润玻璃卡片与圆角滚动条。",
  "base": "light",
  "preview": "preview.png",
  "colors": {
    "background": "#fff8fb",
    "foreground": "#3b2a33",
    "accent": "#e86a92",
    "accentForeground": "#ffffff",
    "sidebar": "#fdeef3",
    "titleBar": "#f9dfe8",
    "panel": "#fff1f6",
    "border": "#f3c6d6",
    "selection": "#f8bbd088",
    "input": "#ffffff",
    "muted": "#9a7b88"
  },
  "surfaces": {
    "radius": "15px",
    "glass_blur": 14,
    "card_opacity": 0.88,
    "border_glow": "rgba(232, 106, 146, 0.22)",
    "noise_grain": 0.015,
    "shadow_elevation": "0 16px 36px -12px rgba(232, 106, 146, 0.18)"
  },
  "background": [
    {
      "image": "sakura.webp",
      "target": "conversation",
      "opacity": 0.16,
      "blur": 2,
      "position": "right bottom",
      "size": "cover"
    }
  ],
  "font": {
    "family": "'HarmonyOS Sans SC', 'Microsoft YaHei UI', 'PingFang SC', 'Noto Sans CJK SC', sans-serif",
    "size": 13
  },
  "icons": {
    "color": "#c2185b"
  },
  "css": "aside, [data-sidebar='sidebar'] { border-right: 1px solid #f3c6d6 !important; }\n::-webkit-scrollbar-thumb { border-radius: 8px; }",
  "pet": {
    "character": "nezuko",
    "filter": "saturate(1.1) brightness(1.05)",
    "accent": "#e86a92",
    "scale": 1.0
  }
}
