{
  "schema": 1,
  "id": "sakura-light",
  "name": "樱雪晴空 · 浅色",
  "author": "Antigravity Studio",
  "version": "2.2.0",
  "description": "柔和清透的晴空樱粉护眼主题，融入水彩粉樱糯米小团子、八重樱花心徽章与输入舱双团子伴读轻摆件，温润克制不晃眼。",
  "base": "light",
  "preview": "preview.png",
  "colors": {
    "background": "#fdf7fa",
    "foreground": "#3b2a33",
    "accent": "#e86a92",
    "accentForeground": "#ffffff",
    "sidebar": "#fdeef3",
    "titleBar": "#f9dfe8",
    "panel": "#fff1f6",
    "border": "#f3c6d6",
    "selection": "#f48fb138",
    "input": "#fffcfd",
    "muted": "#9a7b88"
  },
  "surfaces": {
    "radius": "15px",
    "glass_blur": 14,
    "card_opacity": 0.88,
    "border_glow": "rgba(232, 106, 146, 0.22)",
    "noise_grain": 0.015,
    "shadow_elevation": "0 16px 36px -12px rgba(232, 106, 146, 0.18)"
  },
  "background": [
    {
      "image": "sakura.webp",
      "target": "conversation",
      "opacity": 0.16,
      "blur": 2,
      "position": "right bottom",
      "size": "cover"
    }
  ],
  "font": {
    "family": "'HarmonyOS Sans SC', 'Microsoft YaHei UI', 'PingFang SC', 'Noto Sans CJK SC', sans-serif",
    "size": 13
  },
  "icons": {
    "color": "#c2185b",
    "semantic": {
      "app_logo": "icons/app-logo.svg",
      "new_chat": "icons/new-chat.svg",
      "automations": "icons/automations.svg",
      "customizations": "icons/customizations.svg",
      "add_project": "icons/add-project.svg",
      "search": "icons/search.svg",
      "settings": "icons/settings.svg",
      "pinned": "icons/pinned.svg",
      "thinking": "icons/thinking.svg"
    },
    "composer_charm": "icons/charm.svg"
  },
  "css": "aside, [data-sidebar='sidebar'] { border-right: 1px solid #f3c6d6 !important; }\n::-webkit-scrollbar-thumb { border-radius: 8px; }",
  "pet": {
    "character": "nezuko",
    "filter": "saturate(1.1) brightness(1.05)",
    "accent": "#e86a92",
    "scale": 1
  },
  "cssFile": "theme.css"
}
