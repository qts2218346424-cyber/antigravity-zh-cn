{
  "schema": 1,
  "id": "clannad-sakura-hill",
  "name": "CLANNAD · 光坂坡道与团子",
  "author": "Antigravity Studio",
  "version": "2.2.0",
  "description": "「我们开始一起攀登这长长的坡道。」融入古河渚双呆毛粉团子主徽标、团子大家族功能图标与输入舱趴趴三兄弟伴读摆件，晨曦柔雾樱白低饱和护眼画布，优美温润不晃眼。",
  "base": "light",
  "preview": "preview.svg",
  "colors": {
    "background": "#fcf7f9",
    "foreground": "#3b2c35",
    "accent": "#e57399",
    "accentForeground": "#ffffff",
    "sidebar": "#f9eff3",
    "titleBar": "#f5e6ec",
    "panel": "#fbf2f6",
    "border": "#edd0dd",
    "selection": "#f48fb136",
    "input": "#fffcfd",
    "muted": "#947684"
  },
  "surfaces": {
    "radius": "16px",
    "glass_blur": 16,
    "card_opacity": 0.86,
    "border_glow": "rgba(229, 115, 153, 0.24)",
    "noise_grain": 0.015,
    "shadow_elevation": "0 16px 38px -12px rgba(217, 107, 144, 0.20)"
  },
  "variables": {
    "--agzh-clannad-dango-pink": "#f48fb1",
    "--agzh-clannad-dango-blue": "#81d4fa",
    "--agzh-clannad-dango-amber": "#ffe082"
  },
  "background": [
    {
      "image": "dango-sakura.svg",
      "target": "conversation",
      "opacity": 0.16,
      "blur": 0,
      "position": "right bottom",
      "size": "320px",
      "repeat": "no-repeat"
    }
  ],
  "font": {
    "family": "'HarmonyOS Sans SC', 'PingFang SC', 'Microsoft YaHei UI', sans-serif",
    "monoFamily": "'JetBrains Mono', 'Cascadia Code', Consolas, monospace",
    "size": 13,
    "ligatures": true
  },
  "icons": {
    "color": "#d85a84",
    "semantic": {
      "app_logo": "icons/app-logo.svg",
      "new_chat": "icons/new-chat.svg",
      "automations": "icons/automations.svg",
      "customizations": "icons/customizations.svg",
      "add_project": "icons/add-project.svg",
      "search": "icons/search.svg",
      "settings": "icons/settings.svg",
      "pinned": "icons/pinned.svg",
      "thinking": "icons/thinking.svg"
    },
    "composer_charm": "icons/charm.svg"
  },
  "css": "aside, [data-sidebar='sidebar'] { border-right: 1px solid #edd0dd !important; }\nform:has(textarea) { border: 1px solid rgba(229, 115, 153, 0.34) !important; box-shadow: 0 12px 30px -10px rgba(229, 115, 153, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.9); }",
  "pet": {
    "character": "ushio",
    "filter": "saturate(1.06) brightness(1.03)",
    "accent": "#e57399",
    "scale": 1
  },
  "cssFile": "theme.css"
}
