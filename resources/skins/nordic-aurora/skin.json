{
  "schema": 1,
  "id": "nordic-aurora",
  "name": "北境极光 · 冰川矿",
  "author": "Antigravity Studio",
  "version": "2.2.0",
  "description": "斯堪的纳维亚低饱和冷杉岩灰护眼方案，点缀极光青翠琉璃团子与森之光玉微章，清冽宁静不刺眼。",
  "base": "dark",
  "colors": {
    "background": "#0b1417",
    "foreground": "#dbe8eb",
    "accent": "#2dd4bf",
    "accentForeground": "#041c19",
    "sidebar": "#0e1a1e",
    "titleBar": "#091114",
    "panel": "#111f24",
    "border": "#1e333a",
    "selection": "#2dd4bf30",
    "input": "#14262c",
    "muted": "#7b9ba3"
  },
  "surfaces": {
    "radius": "12px",
    "glass_blur": 16,
    "card_opacity": 0.78,
    "border_glow": "rgba(45, 212, 191, 0.16)",
    "noise_grain": 0.025,
    "shadow_elevation": "0 16px 40px -10px rgba(2, 10, 12, 0.72)"
  },
  "font": {
    "family": "'HarmonyOS Sans SC', 'PingFang SC', 'Microsoft YaHei UI', sans-serif",
    "monoFamily": "'Fira Code', 'Cascadia Code', monospace",
    "size": 13,
    "ligatures": true
  },
  "css": "aside, [data-sidebar='sidebar'] { border-right: 1px solid rgba(45, 212, 191, 0.16) !important; }\nform:has(textarea) { border: 1px solid rgba(45, 212, 191, 0.24) !important; }",
  "pet": {
    "character": "prince",
    "accent": "#2dd4bf",
    "scale": 1
  },
  "icons": {
    "semantic": {
      "app_logo": "icons/app-logo.svg",
      "new_chat": "icons/new-chat.svg",
      "automations": "icons/automations.svg",
      "customizations": "icons/customizations.svg",
      "add_project": "icons/add-project.svg",
      "search": "icons/search.svg",
      "settings": "icons/settings.svg",
      "pinned": "icons/pinned.svg",
      "thinking": "icons/thinking.svg"
    },
    "composer_charm": "icons/charm.svg"
  },
  "cssFile": "theme.css"
}
