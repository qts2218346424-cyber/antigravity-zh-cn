{
  "schema": 1,
  "id": "clannad-illusionary-orbs",
  "name": "CLANNAD · 幻想世界光玉",
  "author": "Antigravity Studio",
  "version": "2.3.0",
  "description": "「承载着小镇每一份温柔心愿与奇迹的光玉，缓缓升向星海。」内置星羽心愿光玉主徽标、月白琉璃团子图标组与仰望星尘伴读摆件，深宵苍穹层次晶莹通透。",
  "base": "dark",
  "preview": "preview.svg",
  "colors": {
    "background": "#0d1426",
    "foreground": "#edf2fc",
    "accent": "#f6c453",
    "accentForeground": "#171206",
    "sidebar": "#080d1a",
    "titleBar": "#060a14",
    "panel": "#16223d",
    "border": "#283b63",
    "selection": "#f6c45329",
    "input": "#1b2948",
    "muted": "#8fa1c7"
  },
  "surfaces": {
    "radius": "14px",
    "glass_blur": 22,
    "card_opacity": 0.82,
    "border_glow": "rgba(246, 196, 83, 0.24)",
    "noise_grain": 0.014,
    "shadow_elevation": "0 22px 50px -12px rgba(4, 8, 20, 0.74), 0 3px 10px -2px rgba(4, 8, 20, 0.44)"
  },
  "variables": {
    "--agzh-hikari-gold": "#f6c453",
    "--agzh-hikari-ice": "#7dd3fc"
  },
  "background": [
    {
      "image": "hikari-orbs.svg",
      "target": "conversation",
      "opacity": 0.2,
      "blur": 0,
      "position": "right bottom",
      "size": "460px",
      "repeat": "no-repeat"
    }
  ],
  "font": {
    "family": "Inter, 'HarmonyOS Sans SC', 'PingFang SC', 'Microsoft YaHei UI', sans-serif",
    "monoFamily": "'JetBrains Mono', 'Cascadia Code', Consolas, monospace",
    "size": 13,
    "ligatures": true
  },
  "icons": {
    "color": "#f6c453",
    "semantic": {
      "app_logo": "icons/app-logo.svg",
      "new_chat": "icons/new-chat.svg",
      "automations": "icons/automations.svg",
      "customizations": "icons/customizations.svg",
      "add_project": "icons/add-project.svg",
      "search": "icons/search.svg",
      "settings": "icons/settings.svg",
      "pinned": "icons/pinned.svg",
      "thinking": "icons/thinking.svg"
    },
    "composer_charm": "icons/charm.svg"
  },
  "css": "aside, [data-sidebar='sidebar'] { backdrop-filter: blur(var(--agzh-glass-blur, 22px)); -webkit-backdrop-filter: blur(var(--agzh-glass-blur, 22px)); border-right: 1px solid rgba(246, 196, 83, 0.18) !important; }\n.surface-composer > .surface-composer-card, form:has(textarea) { border: 1px solid rgba(246, 196, 83, 0.26) !important; }",
  "pet": {
    "character": "ushio",
    "accent": "#f6c453",
    "scale": 1
  },
  "cssFile": "theme.css"
}
